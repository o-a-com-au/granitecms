<a class="button" data-block-id="{{ block.id }}" href="{{ block.settings.url }}">{{ block.settings.label }}</a>
{% schema %}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label",
    "url"
  ],
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "default": "Learn more"
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "default": "#"
    }
  }
}
{% endschema %}
